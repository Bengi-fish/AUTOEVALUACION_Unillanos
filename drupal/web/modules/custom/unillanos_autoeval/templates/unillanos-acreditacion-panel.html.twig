{#
/**
 * @file
 * Panel de Acreditación (/admin/acreditacion).
 *
 * Variables:
 * - datos: lo arma AcreditacionController::panel(): q (búsqueda validada),
 *   total (programas que se muestran), total_general, generales (accesos de la
 *   parte superior) y programas (por programa: id, nombre, facultad, nivel,
 *   sede, indicadores y grupos de accesos, cada uno con titulo y enlaces).
 *   Solo trae lo que tiene dato: lo vacío se omite.
 *
 * En pantallas pequeñas cada fila se ve como una tarjeta (solo CSS): los roles
 * explícitos de la tabla conservan su significado para los lectores de pantalla
 * y data-etiqueta pone el nombre de la columna junto a cada dato.
 *
 * Los títulos usan solo el encabezado de la página (h1); el resto son etiquetas
 * y una lista de definiciones, sin saltos de nivel.
 */
#}
<div class="unillanos-acreditacion">
  {% if datos.volver %}
    <p><a class="unillanos-acreditacion__volver" href="{{ datos.volver }}">{{ 'Volver al sitio'|t }}</a></p>
  {% endif %}
  <p>{{ 'Programas publicados y accesos a las pantallas de edición. Para encontrar contenido sin publicar usa la lista de contenido.'|t }}</p>

  {% if datos.generales %}
    <nav aria-label="{{ 'Accesos generales'|t }}">
      <ul class="unillanos-acreditacion__generales">
        {% for enlace in datos.generales %}
          <li><a href="{{ enlace.url }}">{{ enlace.texto }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

  {% if datos.total_general %}
    <form method="get" role="search" class="unillanos-acreditacion__buscador">
      <label for="acreditacion-q">{{ 'Buscar un programa'|t }}</label>
      <input type="search" id="acreditacion-q" class="form-search form-element form-element--type-search" name="q" value="{{ datos.q }}" maxlength="100" autocomplete="off">
      <button type="submit" class="button">{{ 'Buscar'|t }}</button>
      {% if datos.q %}<a href="?">{{ 'Quitar la búsqueda'|t }}</a>{% endif %}
    </form>
  {% endif %}

  {% if not datos.total_general %}
    <p>{{ 'Todavía no hay programas publicados.'|t }}</p>
  {% elseif not datos.total %}
    <p role="status">{{ 'Ningún programa coincide con la búsqueda.'|t }}</p>
  {% else %}
    <p role="status">{% trans %}Se muestra 1 programa.{% plural datos.total %}Se muestran @count programas.{% endtrans %}</p>
    <div class="unillanos-acreditacion__tabla" role="region" aria-label="{{ 'Programas'|t }}" tabindex="0">
      <table role="table">
        <caption class="visually-hidden">{{ 'Programas de autoevaluación con sus accesos de edición'|t }}</caption>
        <thead>
          <tr role="row">
            <th scope="col" role="columnheader">{{ 'Programa'|t }}</th>
            <th scope="col" role="columnheader">{{ 'Facultad'|t }}</th>
            <th scope="col" role="columnheader">{{ 'Nivel'|t }}</th>
            <th scope="col" role="columnheader">{{ 'Sede'|t }}</th>
            <th scope="col" role="columnheader">{{ 'Estado'|t }}</th>
            <th scope="col" role="columnheader">{{ 'Accesos'|t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for programa in datos.programas %}
            <tr role="row">
              <th scope="row" role="rowheader">{{ programa.nombre }}</th>
              <td role="cell" data-etiqueta="{{ 'Facultad'|t }}">{{ programa.facultad }}</td>
              <td role="cell" data-etiqueta="{{ 'Nivel'|t }}">{{ programa.nivel }}</td>
              <td role="cell" data-etiqueta="{{ 'Sede'|t }}">{{ programa.sede }}</td>
              <td role="cell" data-etiqueta="{{ 'Estado'|t }}">{{ programa.indicadores|join(', ') }}</td>
              <td role="cell">
                {% if programa.grupos %}
                  <details>
                    <summary>{{ 'Accesos de edición'|t }}<span class="visually-hidden"> — {{ programa.nombre }}</span></summary>
                    <dl>
                      {% for grupo in programa.grupos %}
                        <dt>{{ grupo.titulo }}</dt>
                        <dd>
                          <ul>
                            {% for enlace in grupo.enlaces %}
                              <li><a href="{{ enlace.url }}">{{ enlace.texto }}<span class="visually-hidden"> — {{ programa.nombre }}</span></a></li>
                            {% endfor %}
                          </ul>
                        </dd>
                      {% endfor %}
                    </dl>
                  </details>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
