{#
/**
 * @file
 * Fila de llamada a la acción.
 */
#}
{% set nivel = (heading ~ '') in ['h2', 'h3', 'h4'] ? heading : 'h2' %}
{% set atributos_boton = view_go ? create_attribute({'data-ua-view-go': view_go}) : create_attribute() %}
<div{{ attributes.addClass('ua-cta-row') }}>
  <div>
    <{{ nivel }} class="ua-h3">{{ title|sin_cortes }}</{{ nivel }}>
    {% if text %}<p>{{ text|sin_cortes }}</p>{% endif %}
  </div>
  {# Con un segundo destino (secondary_label y secondary_url) los dos botones van en una fila. #}
  {% set con_secundario = secondary_label and secondary_url %}
  {% if con_secundario %}<div class="ua-cta-row__acciones">{% endif %}
  {% include 'unillanos:button' with {label: button_label, variant: 'primario', url: button_url, icon: 'arrow-right', icon_position: 'after', attributes: atributos_boton} only %}
  {% if con_secundario %}
    {% include 'unillanos:button' with {label: secondary_label, variant: 'secundario', url: secondary_url, icon: 'arrow-right', icon_position: 'after', icon_size: 'sm'} only %}
  </div>
  {% endif %}
</div>
