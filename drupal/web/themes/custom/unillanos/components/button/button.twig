{#
/**
 * @file
 * Botón o enlace con aspecto de botón.
 *
 * Los atributos adicionales (por ejemplo data-ua-*) llegan en `attributes`.
 *
 * Un enlace desactivado no lleva href (así no recibe foco ni se activa) y se
 * anuncia como enlace no disponible. Solo se imprimen destinos relativos a
 * la raíz (una sola barra, sin «\» ni espacios detrás: los navegadores leen
 * «/\host» y «/<TAB>/host» como «//host»), anclas, consultas, http(s),
 * mailto y tel. Cualquier otro destino (javascript:, rutas sin barra, espacios
 * iniciales) deja el elemento sin href.
 */
#}
{% set variante = variant|default('primario') %}
{% if variante == 'icono' %}
  {% set clases = ['ua-icon-btn'] %}
{% else %}
  {% set clases = ['ua-btn', 'ua-btn--' ~ variante] %}
  {% if size == 'sm' %}
    {% set clases = clases|merge(['ua-btn--sm']) %}
  {% endif %}
{% endif %}
{% set icono %}
  {%- if icon -%}
    {% include 'unillanos:icon' with {name: icon, size: icon_size|default('')} only %}
  {%- endif -%}
{% endset %}
{% set contenido %}
  {%- if variante == 'icono' -%}
    {{ icono }}<span class="ua-sr">{{ label }}</span>
  {%- elseif icon_position == 'after' -%}
    {{ label }}{{ icono }}
  {%- else -%}
    {{ icono }}{{ label }}
  {%- endif -%}
{% endset %}
{% if url %}
  {% set destino_seguro = (url ~ '') matches '~^(?:/(?![/\\\\\\s])|#|\\?|https?://|mailto:|tel:)~i' %}
  {% if disabled %}
    <a{{ attributes.addClass(clases).setAttribute('role', 'link').setAttribute('aria-disabled', 'true') }}>{{ contenido }}</a>
  {% elseif destino_seguro %}
    <a{{ attributes.addClass(clases).setAttribute('href', url) }}>{{ contenido }}</a>
  {% else %}
    <a{{ attributes.addClass(clases).setAttribute('role', 'link').setAttribute('aria-disabled', 'true') }}>{{ contenido }}</a>
  {% endif %}
{% else %}
  {% if disabled %}
    {% set attributes = attributes.setAttribute('disabled', 'disabled') %}
  {% endif %}
  <button{{ attributes.addClass(clases).setAttribute('type', type|default('button')) }}>{{ contenido }}</button>
{% endif %}
