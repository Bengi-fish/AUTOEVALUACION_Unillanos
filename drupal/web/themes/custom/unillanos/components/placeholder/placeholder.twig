{#
/**
 * @file
 * Marcador de imagen.
 */
#}
{% set clases = ['ua-ph'] %}
{% if ratio %}
  {% set clases = clases|merge(['ua-ph--' ~ ratio]) %}
{% endif %}
{% set aria = 'Espacio para imagen: @label'|t({'@label': label}) %}
<div{{ attributes.addClass(clases).setAttribute('role', 'img').setAttribute('aria-label', aria) }}>
  {% include 'unillanos:icon' with {name: 'image', size: 'lg'} only %}
  <span class="ua-ph__label">{{ label }}</span>
  {% if size_label %}<span class="ua-ph__size">{{ size_label }}</span>{% endif %}
</div>
