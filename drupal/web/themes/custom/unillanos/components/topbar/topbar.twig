{#
/**
 * @file
 * Franja superior (44 px). Sin enlaces ni accesibilidad no imprime nada.
 *
 * Un destino que no sea relativo a la raíz (una sola barra, sin «\» ni
 * espacios detrás), ancla, consulta, http(s), mailto o tel se imprime sin
 * href (mismo filtro que unillanos:button).
 *
 * A la derecha van, en este orden, el enlace de accesibilidad, los íconos de
 * redes (unillanos:redes) y el logo GOV.CO enlazado (versión para fondo
 * oscuro, sin modificar). Cada parte se imprime solo si tiene datos.
 *
 * En pantallas pequeñas solo quedan visibles el enlace de accesibilidad, las
 * redes y GOV.CO: los demás enlaces ya están en la web principal y no caben.
 */
#}
{% set seguro = '~^(?:/(?![/\\\\\\s])|#|\\?|https?://|mailto:|tel:)~i' %}
{% set acceso = accessibility and accessibility.title and accessibility.url and ((accessibility.url ~ '') matches seguro) %}
{% set hay_govco = govco and govco.title and govco.url and ((govco.url ~ '') matches seguro) %}
{% set tema = componentMetadata.path|split('/components/')|first %}
{% set redes_validas = (social|default([]))|filter(red => (red.red in ['facebook', 'x', 'instagram', 'youtube']) and red.title and red.url and ((red.url ~ '') matches seguro)) %}
{% set hay_edicion = edicion and edicion.logout_url and ((edicion.logout_url ~ '') matches seguro) %}
{% if links or acceso or redes_validas or hay_govco or hay_edicion %}
  <div{{ attributes.addClass((acceso or redes_validas or hay_govco or hay_edicion) ? 'ua-topbar' : ['ua-topbar', 'ua-topbar--solo-enlaces']) }}>
    <nav class="ua-topbar__inner" aria-label="{{ label|default('Enlaces de la Universidad'|t) }}">
      {% if hay_edicion %}
        {# Solo para quien tiene el permiso del modo edición. #}
        <div class="ua-edicion-barra">
          <button class="ua-edicion-barra__boton" type="button" aria-pressed="false" data-ua-edicion-toggle>
            {%- include 'unillanos:icon' with {name: 'pencil', size: 'sm'} only -%}
            <span>{{ 'Modo edición'|t }}</span>
          </button>
          {% if edicion.micrositio %}
            {% include 'unillanos:edit-link' with {url: edicion.micrositio.url, label: edicion.micrositio.title, show_label: true} only %}
          {% endif %}
          {% if edicion.avanzado and edicion.avanzado.url and ((edicion.avanzado.url ~ '') matches seguro) %}
            {# Página completa de Drupal, no el panel lateral: enlace normal con el aspecto de los lápices. #}
            <a class="ua-edit ua-edit--lapiz ua-edit--texto" href="{{ edicion.avanzado.url }}">
              {%- include 'unillanos:icon' with {name: 'layers', size: 'sm'} only -%}
              <span>{{ edicion.avanzado.title }}</span>
            </a>
          {% endif %}
          <a class="ua-topbar__link" href="{{ edicion.logout_url }}">{{ 'Cerrar sesión'|t }}</a>
        </div>
      {% endif %}
      {% if links %}
        <ul class="ua-topbar__list" role="list">
          {% for enlace in links %}
            <li class="ua-topbar__item">
              {%- if enlace.url and ((enlace.url ~ '') matches seguro) -%}
                <a class="ua-topbar__link" href="{{ enlace.url }}"{% if enlace.externo %} rel="noopener"{% endif %}>
                  <span>{{ enlace.title }}</span>
                  {%- if enlace.externo %}{% include 'unillanos:icon' with {name: 'external', size: 'sm'} only %}<span class="ua-sr"> ({{ 'enlace externo'|t }})</span>{% endif -%}
                </a>
              {%- else -%}
                <span class="ua-topbar__link">{{ enlace.title }}</span>
              {%- endif -%}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if acceso or redes_validas or hay_govco %}
        <div class="ua-topbar__derecha">
          {% if acceso %}
            <a class="ua-topbar__link ua-topbar__acceso" href="{{ accessibility.url }}">
              {%- include 'unillanos:icon' with {name: 'info', size: 'sm'} only -%}
              <span>{{ accessibility.title }}</span>
            </a>
          {% endif %}
          {% if redes_validas %}{% include 'unillanos:redes' with {redes: redes_validas} only %}{% endif %}
          {% if hay_govco %}
            <a class="ua-topbar__govco" href="{{ govco.url }}" rel="noopener">
              <img src="{{ file_url(tema ~ '/images/logos/govco-blanco.svg') }}" alt="{{ govco.title }}">
            </a>
          {% endif %}
        </div>
      {% endif %}
    </nav>
  </div>
{% endif %}
