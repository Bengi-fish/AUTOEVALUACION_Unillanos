{#
/**
 * @file
 * Lista de documentos descargables.
 *
 * El botón de descarga es el componente button: con una url segura es un
 * enlace; sin url (el documento aún no existe) queda desactivado, sin href.
 */
#}
{% set nivel = (heading ~ '') in ['h2', 'h3', 'h4'] ? heading : 'h3' %}
<ul{{ attributes.addClass(spaced ? ['ua-docs', 'ua-docs--spaced'] : ['ua-docs']).setAttribute('role', 'list') }}>
  {% for doc in items %}
    <li class="ua-doc">
      <span class="ua-doc__icon">
        {%- include 'unillanos:icon' with {name: 'file'} only -%}
        {{ doc.kind|default('PDF') }}
      </span>
      <div class="ua-doc__main">
        {% if doc.cat %}<span class="ua-doc__cat">{{ doc.cat }}</span>{% endif %}
        <{{ nivel }} class="ua-doc__title">{{ doc.title }}</{{ nivel }}>
        {% if doc.desc %}<p class="ua-doc__desc">{{ doc.desc }}</p>{% endif %}
        {% if doc.meta %}<p class="ua-meta">{{ doc.meta }}</p>{% endif %}
      </div>
      {% include 'unillanos:button' with {label: ('Descargar'|t) ~ ' ' ~ doc.title ~ (doc.url ? '' : ' (' ~ ('aún no disponible'|t) ~ ')'), variant: 'icono', icon: 'download', url: doc.url|default(''), disabled: not doc.url} only %}
    </li>
  {% endfor %}
</ul>
