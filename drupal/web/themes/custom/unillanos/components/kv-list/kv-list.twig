{#
/**
 * @file
 * Filas término/valor. Lo vacío no se pinta: ni la fila sin dato ni la lista.
 */
#}
{% set filas = [] %}
{% for dato in items %}
  {% if dato.term and dato.value %}{% set filas = filas|merge([dato]) %}{% endif %}
{% endfor %}
{% if filas %}
<dl{{ attributes.addClass('ua-kv') }}>
  {% for dato in filas %}
    <div class="ua-kv__row"><dt class="ua-kv__term">{{ dato.term }}</dt><dd class="ua-kv__value">{{ dato.value|sin_cortes }}</dd></div>
  {% endfor %}
</dl>
{% endif %}
