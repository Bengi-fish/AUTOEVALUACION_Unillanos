{#
/**
 * @file
 * Encabezado de sección o introducción de panel.
 */
#}
{# Lista blanca: la etiqueta se imprime sin comillas, no puede venir libre. #}
{% set nivel = (heading ~ '') in ['h2', 'h3', 'h4'] ? heading : 'h2' %}
<div{{ attributes.addClass(variant == 'panel' ? 'ua-panel-intro' : 'ua-section__head') }}>
  <div>
    {% if eyebrow %}<span class="ua-eyebrow">{{ eyebrow }}</span>{% endif %}
    <{{ nivel }} class="ua-h2">{{ title }}</{{ nivel }}>
    {% if lead %}<p>{{ lead }}</p>{% endif %}
  </div>
  {% block right %}{{ right }}{% endblock %}
</div>
