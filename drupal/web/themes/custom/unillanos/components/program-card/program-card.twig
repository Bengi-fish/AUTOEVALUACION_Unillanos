{#
/**
 * @file
 * Tarjeta de un programa en el listado.
 *
 * Un solo enlace. Con id, el enlace se nombra por el programa
 * (aria-labelledby) y se describe por la facultad y las etiquetas
 * (aria-describedby), así un lector de pantalla no repite «Ver programa» en
 * cada tarjeta. El nombre va en un título (h3 por defecto) dentro del enlace,
 * como unillanos:card. Lo vacío se omite: sin sede no hay etiqueta de sede y
 * solo se imprime «Con autoevaluación» cuando evaluated es verdadero.
 *
 * Mismo filtro de URL que unillanos:button.
 */
#}
{% set seguro = '~^(?:/(?![/\\\\\\s])|#|\\?|https?://|mailto:|tel:)~i' %}
{% set nivel = (heading ~ '') in ['h2', 'h3', 'h4'] ? heading : 'h3' %}
{% set uid = id is not null and ((id ~ '') matches '~^[A-Za-z0-9_-]+$~') ? 'ua-prog-' ~ id : '' %}
{% set hay_etiquetas = level or campus or evaluated %}
{% set descripcion = [] %}
{% if uid and faculty %}{% set descripcion = descripcion|merge([uid ~ '-f']) %}{% endif %}
{% if uid and hay_etiquetas %}{% set descripcion = descripcion|merge([uid ~ '-e']) %}{% endif %}
<a{{ attributes.addClass('ua-prog') }}{% if url and ((url ~ '') matches seguro) %} href="{{ url }}"{% endif %}{% if uid %} aria-labelledby="{{ uid }}-n"{% endif %}{% if descripcion %} aria-describedby="{{ descripcion|join(' ') }}"{% endif %}>
  <span class="ua-prog__icon">{% include 'unillanos:icon' with {name: 'cap'} only %}</span>
  <div class="ua-prog__body">
    {% if faculty %}<span class="ua-prog__faculty"{% if uid %} id="{{ uid }}-f"{% endif %}>{{ faculty }}</span>{% endif %}
    <{{ nivel }} class="ua-prog__name"{% if uid %} id="{{ uid }}-n"{% endif %}>{{ name }}</{{ nivel }}>
    {% if hay_etiquetas %}
      <span class="ua-prog__meta"{% if uid %} id="{{ uid }}-e"{% endif %}>
        {%- if campus %}{% include 'unillanos:tag' with {label: campus} only %}{% endif -%}
        {%- if level %}{% include 'unillanos:tag' with {label: level} only %}{% endif -%}
        {%- if evaluated %}{% include 'unillanos:tag' with {label: 'Con autoevaluación'|t, variant: 'acento'} only %}{% endif -%}
      </span>
    {% endif %}
    <span class="ua-prog__cta">{{ cta|default('Ver programa'|t) }}{% include 'unillanos:icon' with {name: 'arrow-right', size: 'sm'} only %}</span>
  </div>
</a>
