{#
/**
 * @file
 * Encabezado del sitio: franja superior (opcional), logo, nombre del sistema,
 * menú principal, búsqueda, ingreso y botón del menú móvil.
 *
 * Con `search_url` el buscador es un formulario GET con el campo `q` (lleva a
 * esa URL, p. ej. /programas?q=…); sin ella conserva el campo suelto de la
 * guía de estilos.
 */
#}
{% set id_menu = menu_id|default('ua-menu') %}
{% set seguro = '~^(?:/(?![/\\\\\\s])|#|\\?|https?://|mailto:|tel:)~i' %}
{% set inicio = ((home_url|default('/')) ~ '') matches seguro ? home_url|default('/') : '/' %}
{% set rotulo = kicker is defined ? kicker : 'Sistema de Información de'|t %}
{% set nombre = name is defined ? name : 'Autoevaluación Institucional'|t %}
{% if skip_target %}
  {% include 'unillanos:button' with {label: 'Saltar al contenido'|t, url: skip_target, attributes: create_attribute({class: ['ua-skip']})} only %}
{% endif %}
<header{{ attributes.addClass('ua-header') }}>
  {% if topbar %}
    {% include 'unillanos:topbar' with {links: topbar.links, accessibility: topbar.accessibility} only %}
  {% endif %}
  <div class="ua-header__bar">
    <a class="ua-brand" href="{{ inicio }}">
      {% include 'unillanos:logos' with {solo: solo_logo|default('')} only %}
      {% if rotulo or nombre %}
        <span class="ua-brand__system">{% if rotulo %}<span class="ua-brand__kicker">{{ rotulo }}</span>{% endif %}{% if nombre %}<span class="ua-brand__name">{{ nombre }}</span>{% endif %}</span>
      {% endif %}
    </a>
    {% block nav %}{{ nav }}{% endblock %}
    <div class="ua-header__tools">
      {% if show_search %}
        {% if search_url and ((search_url ~ '') matches seguro) %}
          <form class="ua-search ua-header__search" action="{{ search_url }}" method="get" role="search">
            <label class="ua-sr" for="ua-header-q">{{ 'Buscar un programa'|t }}</label>
            <input id="ua-header-q" type="search" name="q" maxlength="100" autocomplete="off" placeholder="{{ 'Buscar un programa'|t }}">
            <button class="ua-search__submit" type="submit">
              {%- include 'unillanos:icon' with {name: 'search'} only -%}
              <span class="ua-sr">{{ 'Buscar'|t }}</span>
            </button>
          </form>
        {% else %}
          <label class="ua-search">
            {%- include 'unillanos:icon' with {name: 'search'} only -%}
            <span class="ua-sr">{{ 'Buscar en el sitio'|t }}</span>
            <input type="search" placeholder="{{ 'Buscar factores, documentos…'|t }}">
          </label>
        {% endif %}
      {% endif %}
      {% if login_url %}
        {% include 'unillanos:button' with {label: login_label|default('Ingresar'|t), variant: 'secundario', url: login_url, icon: 'user'} only %}
      {% endif %}
      {% if menu_toggle %}
        <button class="ua-menu-toggle" type="button" data-ua-menu-toggle aria-controls="{{ id_menu }}" aria-expanded="false">
          {%- include 'unillanos:icon' with {name: 'menu', attributes: create_attribute({'data-ua-menu-open': true})} only -%}
          {%- include 'unillanos:icon' with {name: 'close', attributes: create_attribute({'data-ua-menu-close': true, hidden: true})} only -%}
          <span class="ua-sr">{{ 'Menú'|t }}</span>
        </button>
      {% endif %}
    </div>
  </div>
</header>
