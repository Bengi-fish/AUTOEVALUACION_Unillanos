{#
/**
 * @file
 * Página base: encabezado con el menú principal, migas, contenido y pie.
 * Los botones flotantes (unillanos:a11y y unillanos:fab) van en una columna
 * fija abajo a la derecha; «Recomendaciones» lleva a «Participa» y se oculta en
 * esa misma página (mostrar_fab).
 *
 * El título (h1), los mensajes y la ayuda van dentro de un contenedor; el
 * contenido de la portada va a todo el ancho para que sus secciones se
 * pinten de borde a borde.
 *
 * Variables:
 * - page: regiones (primary_menu, breadcrumb, page_title, highlighted,
 *   help, content).
 * - is_front, logged_in.
 * - barra_siaai: enlaces de la barra secundaria del SIAAI (vacía fuera de él).
 * - pagina_propia: la plantilla del nodo pinta su cabecera, migas y título
 *   (programa); se omiten el bloque de migas y el del título.
 */
#}
{% embed 'unillanos:header' with {
  skip_target: '#main-content',
  menu_toggle: true,
  menu_id: 'ua-menu',
  menu: page.primary_menu,
  kicker: marco.nombre.linea1,
  name: marco.nombre.linea2,
  solo_logo: 'unillanos',
  show_search: true,
  search_url: path('unillanos_autoeval.programas'),
  edicion: edicion_barra,
} only %}
  {% block nav %}{{ menu }}{% endblock %}
{% endembed %}

{% if barra_siaai %}
  {% include 'unillanos:subnav' with {label: 'SIAAI'|t, items: barra_siaai} only %}
{% endif %}

{% if page.breadcrumb and not pagina_propia %}
  <div class="ua-page__migas">
    <div class="ua-container">{{ page.breadcrumb }}</div>
  </div>
{% endif %}

<main id="main-content" class="ua-main" tabindex="-1">
  {% if (page.page_title and not pagina_propia) or page.highlighted or page.help %}
    <div class="ua-container ua-main__top">
      {% if not pagina_propia %}{{ page.page_title }}{% endif %}
      {{ page.highlighted }}
      {{ page.help }}
    </div>
  {% endif %}
  {% if is_front or pagina_propia %}
    {{ page.content }}
  {% else %}
    <div class="ua-container ua-main__body">
      {{ page.content }}
    </div>
  {% endif %}
</main>

{# No imprime nada: lleva a la página la caché del menú del pie. #}
{{ pie_cache }}
{# El pie lleva los grupos de la configuración del micrositio (ya filtrados). #}
{% set pie = marco.pie %}
{% include 'unillanos:footer' with {
  ubicanos: {title: pie.ubicanos.titulo, sedes: pie.ubicanos.sedes, horario: pie.ubicanos.horario},
  contacto: {title: pie.contacto.titulo, items: pie.contacto.items|map(dato => {title: dato.title, text: dato.text, url: dato.url, icon: dato.icono})},
  lines: {title: pie.lineas.titulo, items: pie.lineas.items|map(dato => {title: dato.title, text: dato.text, url: dato.url, icon: dato.icono})},
  redes_title: pie.redes_titulo,
  redes: marco.redes,
  politicas: {title: pie.politicas.titulo, links: pie.politicas.enlaces},
  explora: pie_enlaces,
  logos: pie.logos|map(logo => {clave: logo.clave, title: logo.title, url: logo.url}),
  rights: pie.derechos,
  edicion: edicion_pie|default(null),
} only %}

{#
  Botones flotantes (esquina inferior derecha): accesibilidad, justo encima de
  «Recomendaciones». Van dentro de un landmark: el contenido fuera de ellos lo
  marcan los lectores de pantalla.
#}
{% if marco.accesibilidad or mostrar_fab %}
  {# role=complementary y no <aside>: la página solo tiene un <aside> (la ficha del programa). #}
  <div class="ua-flotantes" role="complementary" aria-label="{{ 'Accesos rápidos'|t }}">
    {% if marco.accesibilidad %}
      {% include 'unillanos:a11y' with {title: marco.accesibilidad.title, url: marco.accesibilidad.url} only %}
    {% endif %}
    {% if mostrar_fab %}
      {% include 'unillanos:fab' with {
        url: path('unillanos_autoeval.participa') ~ '#recomendacion',
        label: 'Recomendaciones'|t,
        icon: 'message',
        static: true,
      } only %}
    {% endif %}
  </div>
{% endif %}
