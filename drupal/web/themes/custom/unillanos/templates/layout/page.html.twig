{#
/**
 * @file
 * Página base: encabezado con el menú principal, migas, contenido, pie y
 * botón flotante de recomendaciones.
 *
 * El título (h1), los mensajes y la ayuda van dentro de un contenedor; el
 * contenido de la portada va a todo el ancho para que sus secciones se
 * pinten de borde a borde.
 *
 * Variables:
 * - page: regiones (primary_menu, breadcrumb, page_title, highlighted,
 *   help, content).
 * - is_front, logged_in.
 */
#}
{% set cuenta = logged_in
  ? {url: '/user', label: 'Mi cuenta'|t}
  : {url: '/user/login', label: 'Ingresar'|t}
%}
{% embed 'unillanos:header' with {
  skip_target: '#main-content',
  login_url: cuenta.url,
  login_label: cuenta.label,
  menu_toggle: true,
  menu_id: 'ua-menu',
  menu: page.primary_menu,
} only %}
  {% block nav %}{{ menu }}{% endblock %}
{% endembed %}

{% if page.breadcrumb %}
  <div class="ua-page__migas">
    <div class="ua-container">{{ page.breadcrumb }}</div>
  </div>
{% endif %}

<main id="main-content" class="ua-main" tabindex="-1">
  {% if page.page_title or page.highlighted or page.help %}
    <div class="ua-container ua-main__top">
      {{ page.page_title }}
      {{ page.highlighted }}
      {{ page.help }}
    </div>
  {% endif %}
  {% if is_front %}
    {{ page.content }}
  {% else %}
    <div class="ua-container ua-main__body">
      {{ page.content }}
    </div>
  {% endif %}
</main>

{% include 'unillanos:footer' with {
  description: 'Un espacio para consultar, participar y hacer seguimiento a la mejora continua de la Universidad.'|t,
  columns: [
    {title: 'Institucional'|t, links: [
      {title: 'Registro calificado'|t, url: '/institucional#registro-calificado'},
      {title: 'Autoevaluación'|t, url: '/institucional#autoevaluacion'},
      {title: 'Plan de mejoramiento'|t, url: '/institucional#plan-mejoramiento'},
    ]},
    {title: 'Programas y documentos'|t, links: [
      {title: 'Buscar un programa'|t, url: '/programas'},
      {title: 'Normatividad'|t, url: '/documentos#normatividad'},
      {title: 'Documentos base'|t, url: '/documentos#documentos-base'},
      {title: 'Participa'|t, url: '/participa'},
    ]},
  ],
  legal: 'Institución de educación superior sujeta a inspección y vigilancia por el Ministerio de Educación Nacional. © 2026 Universidad de los Llanos.'|t,
  legal_links: [
    {title: 'Política de datos personales'|t},
    {title: 'Mapa del sitio'|t},
    {title: 'Accesibilidad'|t},
  ],
} only %}

{% include 'unillanos:fab' with {label: '¿Tienes una recomendación?'|t, url: '/participa#recomendacion'} only %}
