{#
/**
 * @file
 * Programa académico, vista completa.
 *
 * Variables:
 * - factores: tarjetas y pestañas de factores del proceso del programa (pueden
 *   faltar o estar vacías).
 * - plan: lead, opciones del filtro, filas y aviso del plan de mejoramiento
 *   (vacío si el programa no tiene un plan con metas).
 * - documentos: items, informe y plan del programa (vacío si no tiene
 *   documentos).
 * - programa: (solo en la ruta canónica) datos armados por el presentador (nombre_inicio,
 *   nombre_acento, eyebrow, etiquetas y ficha). Solo trae valores que
 *   existen; no se muestran los títulos de otros nodos ni datos calculados.
 */
#}
<article{{ attributes.addClass('ua-programa') }}>
{% if programa %}
{{ attach_library('unillanos/programa') }}
  {% embed 'unillanos:pagehead' with {
    eyebrow: programa.eyebrow,
    title: programa.nombre_inicio,
    title_accent: programa.nombre_acento,
    lead: 'Registro calificado, autoevaluación y plan de mejoramiento del programa, en un solo lugar.'|t,
    breadcrumb: [{title: 'Inicio'|t, url: '/'}, {title: programa.nombre}],
    etiquetas: programa.etiquetas,
  } only %}
    {% block meta %}
      {% for etiqueta in etiquetas %}
        {% include 'unillanos:tag' with {label: etiqueta, variant: loop.first ? 'acento' : ''} only %}
      {% endfor %}
    {% endblock %}
  {% endembed %}

  {# Con un solo dato la ficha repetiría las etiquetas de la cabecera. #}
  {% if programa.ficha|length > 1 %}
    {% embed 'unillanos:section' with {id: 'ficha', ficha: programa.ficha} only %}
      {% block content %}
        {% include 'unillanos:section-head' with {
          eyebrow: 'Programa académico'|t,
          title: 'Ficha del programa'|t,
        } only %}
        {% include 'unillanos:ficha' with {items: ficha} only %}
      {% endblock %}
    {% endembed %}
  {% endif %}

  {# Factores del proceso (modelo y cantidad según cada programa). #}
  {% set hay_plan = plan.filas|default([]) is not empty %}
  {% if factores.pestanas %}
    {# Banda alterna salvo que la cabecera gris quede pegada a ella (sin ficha). #}
    {% set variante = programa.ficha|length > 1 ? 'alt' : '' %}
    {% embed 'unillanos:section' with {id: 'autoevaluacion', variant: variante, factores: factores, hay_plan: hay_plan, informe: documentos.informe|default(null)} only %}
      {% block content %}
        {% set partes = [] %}
        {% if factores.proceso %}{% set partes = partes|merge([factores.proceso]) %}{% endif %}
        {% if factores.resultado %}{% set partes = partes|merge([('Resultado'|t) ~ ': ' ~ factores.resultado]) %}{% endif %}
        {% embed 'unillanos:section-head' with {
          eyebrow: 'Autoevaluación del programa'|t,
          title: 'Factores y valoración'|t,
          lead: partes|join('. '),
          hay_plan: hay_plan,
          informe: informe,
        } only %}
          {% block right %}
            {% if hay_plan or informe %}
              <div class="ua-section__acciones">
                {% if informe %}
                  {% include 'unillanos:button' with {label: ('Ver'|t) ~ ' ' ~ informe.title ~ ' (' ~ informe.kind ~ ')', variant: 'secundario', url: informe.url, icon: 'download', icon_size: 'sm'} only %}
                {% endif %}
                {% if hay_plan %}
                  {% include 'unillanos:button' with {label: 'Ir al plan de mejoramiento'|t, variant: 'secundario', url: '#plan', icon: 'arrow-right', icon_position: 'after', icon_size: 'sm'} only %}
                {% endif %}
              </div>
            {% endif %}
          {% endblock %}
        {% endembed %}
        {% set hay_grado = false %}
        {% for tarjeta in factores.tarjetas %}
          {% if tarjeta.grade %}{% set hay_grado = true %}{% endif %}
        {% endfor %}
        {% if factores.tarjetas %}
          {% include 'unillanos:factor-card' with {heading: 'h3', image: 'tema', items: factores.tarjetas} only %}
        {% endif %}
        {% if hay_grado %}
          <p class="ua-nota">
            {%- include 'unillanos:icon' with {name: 'info', size: 'sm'} only -%}
            <span>{{ 'Las etiquetas de grado se muestran como están guardadas; la regla de asignación está por confirmar.'|t }}</span>
          </p>
        {% endif %}
        <div class="ua-subsection">
          {% include 'unillanos:factor-tabs' with {
            id: 'factores',
            label: 'Factores del programa'|t,
            heading: 'h3',
            image: 'tema',
            report: false,
            items: factores.pestanas,
          } only %}
        </div>
      {% endblock %}
    {% endembed %}
  {% endif %}

  {# Plan de mejoramiento del proceso (una fila por meta). #}
  {% if hay_plan %}
    {% embed 'unillanos:section' with {id: 'plan', plan: plan, hay_factores: factores.pestanas is not empty, plan_documento: documentos.plan|default(null)} only %}
      {% block content %}
        {% embed 'unillanos:section-head' with {
          eyebrow: 'Plan de mejoramiento'|t,
          title: 'Acciones del programa'|t,
          lead: plan.lead,
          hay_factores: hay_factores,
          plan_documento: plan_documento,
        } only %}
          {% block right %}
            {% if hay_factores or plan_documento %}
              <div class="ua-section__acciones">
                {% if plan_documento %}
                  {% include 'unillanos:button' with {label: ('Descargar'|t) ~ ' ' ~ plan_documento.title ~ ' (' ~ plan_documento.kind ~ ')', variant: 'secundario', url: plan_documento.url, icon: 'download', icon_size: 'sm'} only %}
                {% endif %}
                {% if hay_factores %}
                  {% include 'unillanos:button' with {label: 'Volver a los factores'|t, variant: 'secundario', url: '#autoevaluacion', icon: 'chevron-left', icon_size: 'sm'} only %}
                {% endif %}
              </div>
            {% endif %}
          {% endblock %}
        {% endembed %}
        {% include 'unillanos:plan-filter' with {
          heading: 'h3',
          title: 'Acciones de mejora'|t,
          show_plazo: false,
          factor_options: plan.opciones,
          page_size: 6,
          columns: [
            {label: 'Situación para intervenir'|t},
            {label: 'Acción de mejora'|t},
            {label: 'Responsables'|t},
            {label: 'Avance reportado'|t},
          ],
          rows: plan.filas,
        } only %}
        {% if plan.aviso %}
          <p class="ua-nota">
            {%- include 'unillanos:icon' with {name: 'info', size: 'sm'} only -%}
            <span>{{ 'El avance es el reportado por el programa en cada periodo; no está verificado.'|t }}</span>
          </p>
        {% endif %}
      {% endblock %}
    {% endembed %}
  {% endif %}

  {# Documentos del programa (informe, plan y los demás). #}
  {% if documentos.items %}
    {% embed 'unillanos:section' with {id: 'documentos', variant: 'alt', documentos: documentos} only %}
      {% block content %}
        {% include 'unillanos:section-head' with {
          eyebrow: 'Documentos'|t,
          title: 'Documentos del programa'|t,
          lead: 'Informes, planes y otros documentos descargables de este programa.'|t,
        } only %}
        {% include 'unillanos:doc-list' with {heading: 'h3', items: documentos.items} only %}
      {% endblock %}
    {% endembed %}
  {% endif %}
{% else %}
  {{ content }}
{% endif %}
</article>
