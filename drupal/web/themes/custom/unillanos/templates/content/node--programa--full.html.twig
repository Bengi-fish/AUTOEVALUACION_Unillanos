{#
/**
 * @file
 * Programa académico, vista completa.
 *
 * Variables:
 * - factores: tarjetas y pestañas de factores del proceso del programa (pueden
 *   faltar o estar vacías).
 * - plan: lead, opciones del filtro, filas y aviso del plan de mejoramiento
 *   (vacío si el programa no tiene un plan con metas).
 * - documentos: items, informe y plan del programa (vacío si no tiene
 *   documentos).
 * - lead, otros y enlaces: los arma PaginaPrograma (bajada según las secciones que
 *   existen; los demás programas de la facultad y los enlaces solo si el
 *   programa no tiene nada de autoevaluación).
 * - programa: (solo en la ruta canónica) datos armados por PaginaPrograma::datosPrograma() (nombre_inicio,
 *   nombre_acento, eyebrow, etiquetas y ficha). Solo trae valores que
 *   existen; no se muestran los títulos de otros nodos ni datos calculados.
 */
#}
<article{{ attributes.addClass('ua-programa') }}>
{% if programa %}
{{ attach_library('unillanos/programa') }}
  {% embed 'unillanos:pagehead' with {
    eyebrow: programa.eyebrow,
    title: programa.nombre_inicio,
    title_accent: programa.nombre_acento,
    lead: lead,
    breadcrumb: [{title: 'Inicio'|t, url: '/'}, {title: 'Información'|t}, {title: 'SIAAI'|t, url: path('unillanos_autoeval.portada')}, {title: 'Programas'|t, url: path('unillanos_autoeval.programas')}, {title: programa.nombre}],
    etiquetas: programa.etiquetas,
    variant: 'hero',
    image: programa.imagen,
    photo_edit: edicion.foto|default(null),
  } only %}
    {% block meta %}
      {% for etiqueta in etiquetas %}
        {% include 'unillanos:tag' with {label: etiqueta, variant: loop.first ? 'acento' : ''} only %}
      {% endfor %}
    {% endblock %}
  {% endembed %}

  {# Modo edición: ficha, plan y documentos (solo con permiso y acceso real;
     se ve únicamente con el modo activo). #}
  {% if edicion %}
    <div class="ua-container">
      <div class="ua-edicion-zona">
        {% for enlace in [edicion.ficha|default(null), edicion.plan|default(null), edicion.documento|default(null)] %}
          {% if enlace %}{% include 'unillanos:edit-link' with {url: enlace.url, label: enlace.title, variant: enlace.tipo, show_label: true} only %}{% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# Con un solo dato la ficha repetiría las etiquetas de la cabecera. La
     ficha es un aside a la derecha del primer bloque de contenido. #}
  {% set hay_ficha = programa.ficha|length > 1 %}
  {% set ficha_aside %}
    {%- if hay_ficha -%}
      {% include 'unillanos:ficha' with {variant: 'aside', eyebrow: 'Programa académico'|t, title: 'Ficha del programa'|t, items: programa.ficha, attributes: create_attribute({id: 'ficha'})} only %}
    {%- endif -%}
  {% endset %}

  {# Factores, plan y documentos: el mismo parcial que usa «Institucional». #}
  {% include '@unillanos/templates/content/partials/autoevaluacion.html.twig' with {
    factores: factores,
    plan: plan,
    documentos: documentos,
    hay_ficha: hay_ficha,
    ficha_aside: ficha_aside,
    textos: {
      autoevaluacion: 'Autoevaluación del programa'|t,
      factores: 'Factores y valoración'|t,
      etiqueta_factores: 'Factores del programa'|t,
      acciones: 'Acciones del programa'|t,
      documentos: 'Documentos del programa'|t,
      documentos_lead: 'Informes, planes y otros documentos descargables de este programa.'|t,
      aviso_avance: 'El avance es el reportado por el programa en cada periodo; no está verificado.'|t,
    },
  } only %}
  {# Sin nada de autoevaluación: los demás programas de la facultad y los enlaces. #}
  {% set otros_bloque %}
        {% if otros %}
          {# La facultad ya está en la cabecera y en el título: no se repite. #}
          {% include 'unillanos:section-head' with {title: otros.titulo} only %}
          <ul class="ua-prog-list" role="list">
            {% for otro in otros.programas %}
              <li>
                {# Un dato ausente se pasa vacío: el esquema del componente no admite NULL. #}
                {% include 'unillanos:program-card' with {
                  name: otro.nombre,
                  id: otro.id,
                  url: otro.url|default(''),
                  faculty: '',
                  level: otro.nivel|default(''),
                  modality: otro.modalidad|default(''),
                  duration: otro.duracion|default(''),
                  campus: otro.sede|default(''),
                  evaluated: otro.con_autoevaluacion|default(false),
                  heading: 'h3',
                } only %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if enlaces %}
          <div class="ua-programa__enlaces">
            {% for enlace in enlaces %}
              {% include 'unillanos:button' with {label: enlace.label, variant: 'secundario', url: enlace.url, icon: 'arrow-right', icon_position: 'after', icon_size: 'sm'} only %}
            {% endfor %}
          </div>
        {% endif %}
  {% endset %}
  {% if hay_ficha and not factores.pestanas %}
    {# Sin factores, la ficha va a la derecha de este primer bloque. #}
    {% embed 'unillanos:section' with {id: (otros or enlaces) ? 'otros-programas' : 'zona-ficha', principal: otros_bloque, ficha_aside: ficha_aside} only %}
      {% block content %}
        <div class="ua-programa__zona ua-programa__zona--ficha">
          <div class="ua-programa__principal">{{ principal }}</div>
          {{ ficha_aside }}
        </div>
      {% endblock %}
    {% endembed %}
  {%- elseif otros or enlaces -%}
    {% embed 'unillanos:section' with {id: 'otros-programas', principal: otros_bloque} only %}
      {% block content %}{{ principal }}{% endblock %}
    {% endembed %}
  {%- endif %}
{% else %}
  {{ content }}
{% endif %}
</article>
