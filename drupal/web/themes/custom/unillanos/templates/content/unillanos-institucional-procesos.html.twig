{#
/**
 * @file
 * Procesos institucionales (/institucional/procesos).
 *
 * Variables:
 * - datos: lo arma InstitucionalProcesos::datos(): principal (el proceso
 *   institucional más reciente, con factores, plan y documentos si los hay),
 *   condiciones (una por sede) y vacio. Solo trae lo que existe: lo vacío se
 *   omite.
 */
#}
{% set principal = datos.principal %}
{% include 'unillanos:pagehead' with {
  eyebrow: 'Institucional'|t,
  title: 'Procesos'|t,
  title_accent: 'institucionales'|t,
  lead: 'Autoevaluación con fines de acreditación institucional y condiciones institucionales por sede.'|t,
  breadcrumb: [{title: 'Inicio'|t, url: '/'}, {title: 'Información'|t}, {title: 'SIAAI'|t, url: path('unillanos_autoeval.portada')}, {title: 'Institucional'|t, url: path('unillanos_autoeval.institucional')}, {title: 'Procesos institucionales'|t}],
} only %}

{% if datos.vacio %}
  {% embed 'unillanos:section' with {id: 'procesos'} only %}
    {% block content %}
      <p class="ua-lead ua-docs-vacio">{{ 'Todavía no hay procesos institucionales publicados.'|t }}</p>
    {% endblock %}
  {% endembed %}
{% endif %}

{% if principal %}
  {% embed 'unillanos:section' with {id: 'autoevaluacion-institucional', principal: principal} only %}
    {% block content %}
      {% set partes = [] %}
      {% if principal.periodo %}{% set partes = partes|merge([('Periodo'|t) ~ ': ' ~ principal.periodo]) %}{% endif %}
      {% if principal.estado %}{% set partes = partes|merge([('Estado'|t) ~ ': ' ~ principal.estado]) %}{% endif %}
      {% if principal.sede %}{% set partes = partes|merge([principal.sede]) %}{% endif %}
      {% if principal.resultado %}{% set partes = partes|merge([('Resultado'|t) ~ ': ' ~ principal.resultado]) %}{% endif %}
      {% include 'unillanos:section-head' with {eyebrow: 'Autoevaluación institucional'|t, title: principal.titulo, lead: partes|join('. ')} only %}
      {% if principal.edicion %}
        <div class="ua-edicion-zona">
          {% for enlace in principal.edicion %}
            {% include 'unillanos:edit-link' with {url: enlace.url, label: enlace.title, variant: enlace.tipo, show_label: true} only %}
          {% endfor %}
        </div>
      {% endif %}
      {% if principal.factores.tarjetas %}
        {% include 'unillanos:factor-card' with {heading: 'h3', image: 'tema', items: principal.factores.tarjetas} only %}
      {% endif %}
      {% if principal.factores.pestanas %}
        <div class="ua-subsection">
          {% include 'unillanos:factor-tabs' with {id: 'factores', label: 'Factores del proceso'|t, heading: 'h3', image: 'tema', report: false, items: principal.factores.pestanas} only %}
        </div>
      {% endif %}
      {% if principal.documentos %}
        <div class="ua-subsection">
          {% include 'unillanos:section-head' with {heading: 'h3', title: 'Documentos del proceso'|t} only %}
          {% include 'unillanos:doc-list' with {heading: 'h4', items: principal.documentos} only %}
        </div>
      {% endif %}
    {% endblock %}
  {% endembed %}

  {% if principal.plan.filas %}
    {% embed 'unillanos:section' with {id: 'plan', variant: 'alt', plan: principal.plan} only %}
      {% block content %}
        {% include 'unillanos:section-head' with {eyebrow: 'Plan de mejoramiento'|t, title: 'Acciones institucionales'|t, lead: plan.lead} only %}
        {% include 'unillanos:plan-filter' with {
          heading: 'h3',
          title: 'Acciones de mejora'|t,
          show_plazo: false,
          factor_options: plan.opciones,
          page_size: 6,
          columns: [
            {label: 'Situación para intervenir'|t},
            {label: 'Acción de mejora'|t},
            {label: 'Responsables'|t},
            {label: 'Avance reportado'|t},
          ],
          rows: plan.filas,
        } only %}
      {% endblock %}
    {% endembed %}
  {% endif %}
{% endif %}

{% if datos.condiciones %}
  {% embed 'unillanos:section' with {id: 'condiciones', variant: principal ? 'alt' : '', condiciones: datos.condiciones} only %}
    {% block content %}
      {% include 'unillanos:section-head' with {eyebrow: 'Condiciones institucionales'|t, title: 'Condiciones institucionales por sede'|t, lead: 'Los documentos de las condiciones de calidad de cada sede.'|t} only %}
      {% set entradas = [] %}
      {% for sede in condiciones %}
        {% set grupos = [] %}
        {% set cuenta = 0 %}
        {% set acciones = {} %}
        {% for proceso in sede.procesos %}
          {% set cuenta = cuenta + proceso.items|length %}
          {% set grupos = grupos|merge([{title: proceso.titulo, items: proceso.items}]) %}
          {% if proceso.edicion %}{% set acciones = acciones|merge({('d' ~ loop.index): proceso.edicion}) %}{% endif %}
        {% endfor %}
        {% set entradas = entradas|merge([{id: sede.id, title: sede.titulo, count: cuenta, groups: grupos, edicion: acciones}]) %}
      {% endfor %}
      {% include 'unillanos:accordion' with {id: 'sedes', heading: 'h3', items: entradas} only %}
    {% endblock %}
  {% endembed %}
{% endif %}
