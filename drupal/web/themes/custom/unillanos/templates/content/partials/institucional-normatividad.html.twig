{#
/**
 * @file
 * Sección «Normatividad» de /institucional: la matriz legal con filtros.
 *
 * Variables (se pasan con `only`):
 * - datos: InstitucionalNormas::datos() (filas, origenes, tipos, total,
 *   edicion, vacio); se traducen las claves a los props del componente.
 * - alterna: TRUE para la banda gris.
 */
#}
{% embed 'unillanos:section' with {id: 'normatividad', variant: alterna ? 'alt' : '', datos: datos} only %}
  {% block content %}
    {% include 'unillanos:section-head' with {eyebrow: 'Institucional'|t, title: 'Matriz legal aplicable'|t, lead: 'Normas que aplican a los procesos de la Universidad de los Llanos.'|t} only %}
    {% if datos.edicion.nueva %}
      <div class="ua-edicion-zona">{% include 'unillanos:edit-link' with {url: datos.edicion.nueva.url, label: datos.edicion.nueva.title, variant: datos.edicion.nueva.tipo, show_label: true} only %}</div>
    {% endif %}
    {% if not datos.vacio %}
      {% set filas = [] %}
      {% for fila in datos.filas %}
        {% set filas = filas|merge([{
          origin: fila.origen,
          origin_key: fila.origen_clave,
          type: fila.tipo,
          type_key: fila.tipo_clave,
          number: fila.numero,
          entity: fila.entidad,
          epigraph: fila.epigrafe,
          chapters: fila.capitulos,
          application: fila.aplicacion,
          link: fila.link|default({}),
          search: fila.buscar,
          edit: fila.edicion|default({}),
        }]) %}
      {% endfor %}
      {% set origenes = [] %}
      {% for o in datos.origenes %}{% set origenes = origenes|merge([{value: o.valor, label: o.etiqueta, count: o.conteo}]) %}{% endfor %}
      {% set tipos = [] %}
      {% for t in datos.tipos %}{% set tipos = tipos|merge([{value: t.valor, label: t.etiqueta, count: t.conteo}]) %}{% endfor %}
      {% include 'unillanos:norm-table' with {id: 'matriz', total: datos.total, origins: origenes, types: tipos, rows: filas} only %}
    {% endif %}
  {% endblock %}
{% endembed %}
