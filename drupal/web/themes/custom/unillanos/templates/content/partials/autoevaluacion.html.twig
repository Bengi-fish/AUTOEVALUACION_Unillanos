{#
/**
 * @file
 * Secciones de autoevaluación compartidas: factores con su valoración, plan de
 * mejoramiento y documentos. Las usan la página del programa y la de
 * «Institucional» (la misma interfaz, con otros textos).
 *
 * Variables (se pasan con `only`):
 * - factores, plan, documentos: los arman FactoresPrograma,
 *   PlanMejoramientoPrograma y DocumentosPublicados (pueden faltar o estar
 *   vacíos; lo vacío se omite).
 * - hay_ficha y ficha_aside: la ficha lateral ya pintada, si la hay.
 * - textos: autoevaluacion, factores, etiqueta_factores, acciones, documentos,
 *   documentos_lead y aviso_avance (ya traducidos).
 */
#}
  {# Factores del proceso (modelo y cantidad según cada programa). #}
  {% set hay_plan = plan.filas|default([]) is not empty %}
  {% if factores.pestanas %}
    {# Banda alterna salvo que la cabecera gris quede pegada a ella (sin ficha). #}
    {% set variante = hay_ficha ? 'alt' : '' %}
    {% embed 'unillanos:section' with {id: 'autoevaluacion', textos: textos, variant: variante, factores: factores, hay_plan: hay_plan, informe: documentos.informe|default(null), hay_ficha: hay_ficha, ficha_aside: ficha_aside} only %}
      {% block content %}
        {% set partes = [] %}
        {% if factores.proceso %}{% set partes = partes|merge([factores.proceso]) %}{% endif %}
        {% if factores.resultado %}{% set partes = partes|merge([('Resultado'|t) ~ ': ' ~ factores.resultado]) %}{% endif %}
        <div class="ua-programa__zona{% if hay_ficha %} ua-programa__zona--ficha{% endif %}">
          <div class="ua-programa__principal">
          {% embed 'unillanos:section-head' with {
            eyebrow: textos.autoevaluacion,
            title: textos.factores,
            lead: partes|join('. '),
            hay_plan: hay_plan,
            informe: informe,
          } only %}
            {% block right %}
              {% if hay_plan or informe %}
                <div class="ua-section__acciones">
                  {% if informe %}
                    {% if informe.externo %}
                      {% include 'unillanos:button' with {label: ('Abrir'|t) ~ ' ' ~ informe.title ~ ' (' ~ informe.rotulo|default(informe.kind) ~ '; ' ~ ('se abre en una pestaña nueva'|t) ~ ')', variant: 'secundario', url: informe.url, icon: 'external', icon_size: 'sm', attributes: create_attribute({target: '_blank', rel: 'noopener noreferrer'})} only %}
                    {% else %}
                      {% include 'unillanos:button' with {label: ('Ver'|t) ~ ' ' ~ informe.title ~ ' (' ~ informe.kind ~ ')', variant: 'secundario', url: informe.url, icon: 'download', icon_size: 'sm'} only %}
                    {% endif %}
                  {% endif %}
                  {% if hay_plan %}
                    {% include 'unillanos:button' with {label: 'Ir al plan de mejoramiento'|t, variant: 'secundario', url: '#plan', icon: 'arrow-right', icon_position: 'after', icon_size: 'sm'} only %}
                  {% endif %}
                </div>
              {% endif %}
            {% endblock %}
          {% endembed %}
          </div>
          {% if hay_ficha %}{{ ficha_aside }}{% endif %}
        </div>
        {% set hay_grado = false %}
        {% for tarjeta in factores.tarjetas %}
          {% if tarjeta.grade %}{% set hay_grado = true %}{% endif %}
        {% endfor %}
        {% if factores.tarjetas %}
          {% include 'unillanos:factor-card' with {heading: 'h3', image: 'tema', items: factores.tarjetas} only %}
        {% endif %}
        {% if hay_grado %}
          <p class="ua-nota">
            {%- include 'unillanos:icon' with {name: 'info', size: 'sm'} only -%}
            <span>{{ 'Las etiquetas de grado se muestran como están guardadas; la regla de asignación está por confirmar.'|t }}</span>
          </p>
        {% endif %}
        <div class="ua-subsection">
          {% include 'unillanos:factor-tabs' with {
            id: 'factores',
            label: textos.etiqueta_factores,
            heading: 'h3',
            image: 'tema',
            report: false,
            items: factores.pestanas,
          } only %}
        </div>
      {% endblock %}
    {% endembed %}
  {% endif %}

  {# Plan de mejoramiento del proceso (una fila por meta). #}
  {% if hay_plan %}
    {% embed 'unillanos:section' with {id: 'plan', textos: textos, plan: plan, hay_factores: factores.pestanas is not empty, plan_documento: documentos.plan|default(null)} only %}
      {% block content %}
        {% embed 'unillanos:section-head' with {
          eyebrow: 'Plan de mejoramiento'|t,
          title: textos.acciones,
          lead: plan.lead,
          hay_factores: hay_factores,
          plan_documento: plan_documento,
        } only %}
          {% block right %}
            {% if hay_factores or plan_documento %}
              <div class="ua-section__acciones">
                {% if plan_documento %}
                  {% if plan_documento.externo %}
                    {% include 'unillanos:button' with {label: ('Abrir'|t) ~ ' ' ~ plan_documento.title ~ ' (' ~ plan_documento.rotulo|default(plan_documento.kind) ~ '; ' ~ ('se abre en una pestaña nueva'|t) ~ ')', variant: 'secundario', url: plan_documento.url, icon: 'external', icon_size: 'sm', attributes: create_attribute({target: '_blank', rel: 'noopener noreferrer'})} only %}
                  {% else %}
                    {% include 'unillanos:button' with {label: ('Descargar'|t) ~ ' ' ~ plan_documento.title ~ ' (' ~ plan_documento.kind ~ ')', variant: 'secundario', url: plan_documento.url, icon: 'download', icon_size: 'sm'} only %}
                  {% endif %}
                {% endif %}
                {% if hay_factores %}
                  {% include 'unillanos:button' with {label: 'Volver a los factores'|t, variant: 'secundario', url: '#autoevaluacion', icon: 'chevron-left', icon_size: 'sm'} only %}
                {% endif %}
              </div>
            {% endif %}
          {% endblock %}
        {% endembed %}
        {% include 'unillanos:plan-filter' with {
          heading: 'h3',
          title: 'Acciones de mejora'|t,
          show_plazo: false,
          factor_options: plan.opciones,
          page_size: 6,
          columns: [
            {label: 'Situación para intervenir'|t},
            {label: 'Acción de mejora'|t},
            {label: 'Responsables'|t},
            {label: 'Avance reportado'|t},
          ],
          rows: plan.filas,
        } only %}
        {% if plan.aviso %}
          <p class="ua-nota">
            {%- include 'unillanos:icon' with {name: 'info', size: 'sm'} only -%}
            <span>{{ textos.aviso_avance }}</span>
          </p>
        {% endif %}
      {% endblock %}
    {% endembed %}
  {% endif %}

  {# Documentos del programa (informe, plan y los demás). #}
  {% if documentos.items %}
    {% embed 'unillanos:section' with {id: 'documentos', textos: textos, variant: 'alt', documentos: documentos} only %}
      {% block content %}
        {% include 'unillanos:section-head' with {
          eyebrow: 'Documentos'|t,
          title: textos.documentos,
          lead: textos.documentos_lead,
        } only %}
        {% include 'unillanos:doc-list' with {heading: 'h3', items: documentos.items} only %}
      {% endblock %}
    {% endembed %}
  {% endif %}
