{#
/**
 * @file
 * Portada de «Institucional» (/institucional).
 *
 * Variables:
 * - datos: lo arma InstitucionalPortada::datos(): intro (puede estar vacía) y
 *   tarjetas (icon, title, text, url y cta). La frase de introducción sale de
 *   la configuración del micrositio. El h1 es el título de la cabecera.
 */
#}
{% include 'unillanos:pagehead' with {
  eyebrow: 'Institucional'|t,
  title: 'La Universidad y su'|t,
  title_accent: 'autoevaluación'|t,
  lead: datos.intro,
  breadcrumb: [{title: 'Inicio'|t, url: '/'}, {title: 'Institucional'|t}],
} only %}

{% embed 'unillanos:section' with {id: 'modulos', datos: datos} only %}
  {% block content %}
    {% if datos.edicion.micrositio %}
      <div class="ua-edicion-zona">{% include 'unillanos:edit-link' with {url: datos.edicion.micrositio.url, label: datos.edicion.micrositio.title, variant: datos.edicion.micrositio.tipo, show_label: true} only %}</div>
    {% endif %}
    {% include 'unillanos:card' with {heading: 'h2', items: datos.tarjetas} only %}
  {% endblock %}
{% endembed %}
