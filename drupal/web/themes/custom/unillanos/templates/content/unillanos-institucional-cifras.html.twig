{#
/**
 * @file
 * Cifras (/institucional/cifras): enlaces externos y el tablero institucional.
 *
 * Variables:
 * - datos: lo arma InstitucionalCifras::datos(): enlaces (title, text, url y
 *   external), tablero (url, embed_url y host, o NULL), edicion y vacio.
 *   El tablero es de otro sitio: no se carga solo, solo al pulsar el botón.
 */
#}
{% include 'unillanos:pagehead' with {
  eyebrow: 'Institucional'|t,
  title: 'Cifras y'|t,
  title_accent: 'estadísticas'|t,
  lead: 'Cifras nacionales de estudiantes y egresados, y cifras de la Universidad.'|t,
  breadcrumb: [{title: 'Inicio'|t, url: '/'}, {title: 'Institucional'|t, url: path('unillanos_autoeval.institucional')}, {title: 'Cifras'|t}],
} only %}

{% embed 'unillanos:section' with {id: 'cifras', datos: datos} only %}
  {% block content %}
    {% if datos.edicion.micrositio %}
      <div class="ua-edicion-zona">{% include 'unillanos:edit-link' with {url: datos.edicion.micrositio.url, label: datos.edicion.micrositio.title, variant: datos.edicion.micrositio.tipo, show_label: true} only %}</div>
    {% endif %}
    {% if datos.vacio %}
      <p class="ua-lead ua-docs-vacio">{{ 'Todavía no hay cifras publicadas.'|t }}</p>
    {% endif %}
    {% if datos.enlaces %}
      {% include 'unillanos:section-head' with {eyebrow: 'Cifras nacionales'|t, title: 'Estudiantes y graduados en Colombia'|t, lead: 'Consultas del Ministerio de Educación Nacional. Se abren en otro sitio.'|t} only %}
      {% include 'unillanos:card' with {heading: 'h3', items: datos.enlaces} only %}
    {% endif %}
  {% endblock %}
{% endembed %}

{% if datos.tablero %}
  {% embed 'unillanos:section' with {id: 'tablero', variant: 'alt', tablero: datos.tablero} only %}
    {% block content %}
      {% include 'unillanos:section-head' with {eyebrow: 'Cifras institucionales'|t, title: 'Tablero institucional'|t, lead: 'Cantidad de programas por facultad y otras cifras de la Universidad.'|t} only %}
      {% include 'unillanos:embed-diferido' with {
        id: 'tablero-institucional',
        title: 'Tablero de cifras institucionales'|t,
        embed_url: tablero.embed_url,
        open_url: tablero.url,
        host: tablero.host,
        button_label: 'Cargar el tablero'|t,
        open_label: 'Abrir en Tableau Public'|t,
        notice: 'El tablero es de otro sitio (Tableau Public): solo se carga si usted lo pide.'|t,
        height: 1000,
      } only %}
    {% endblock %}
  {% endembed %}
{% endif %}
