{#
/**
 * @file
 * Menú principal plano: lo pinta el componente unillanos:nav.
 *
 * El menú es plano a propósito (sin submenús): solo se imprimen los
 * elementos del primer nivel. «Ingresar» pasa a ser el último elemento del
 * menú móvil (el botón del encabezado se oculta allí).
 *
 * La página actual se marca por la ruta activa o porque el enlace apunta a
 * la URL actual (los enlaces por alias, como el del programa, no siempre
 * entran en la ruta activa).
 */
#}
{% set enlaces = [] %}
{% for item in items %}
  {# La página exacta (aria-current="page") y, aparte, el recorrido: un enlace
     que contiene la página actual sin serlo (aria-current="true"). #}
  {% set exacto = (enlace_activo and item.original_link.pluginId == enlace_activo) or (item.url.toString == path('<current>')) %}
  {% set enlaces = enlaces|merge([{
    title: item.title,
    url: item.url.toString,
    active: exacto,
    trail: item.in_active_trail and not exacto,
  }]) %}
{% endfor %}
{% set cuenta = logged_in
  ? {url: '/user', title: 'Mi cuenta'|t}
  : {url: '/user/login', title: 'Ingresar'|t}
%}
{% include 'unillanos:nav' with {items: enlaces, id: 'ua-menu', login: cuenta} only %}
