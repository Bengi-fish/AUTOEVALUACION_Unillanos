# Ejemplo para Apache 2.4 con PHP-FPM. Reemplace el dominio, las rutas y el
# certificado. Habilite mod_rewrite, mod_headers, mod_ssl y mod_proxy_fcgi.
<VirtualHost *:80>
  ServerName autoevaluacion.ejemplo.edu.co
  Redirect permanent / https://autoevaluacion.ejemplo.edu.co/
</VirtualHost>

<VirtualHost *:443>
  ServerName autoevaluacion.ejemplo.edu.co
  DocumentRoot /var/www/autoeval/drupal/web

  SSLEngine on
  SSLCertificateFile /ruta/al/certificado.crt
  SSLCertificateKeyFile /ruta/a/la/clave.key

  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"

  <Directory /var/www/autoeval/drupal/web>
    AllowOverride All
    Require all granted
  </Directory>

  # Los archivos subidos nunca se ejecutan como PHP.
  <Directory /var/www/autoeval/drupal/web/sites/default/files>
    <FilesMatch "\.php$">
      Require all denied
    </FilesMatch>
  </Directory>

  <FilesMatch "\.php$">
    SetHandler "proxy:unix:/run/php/php8.4-fpm.sock|fcgi://localhost"
  </FilesMatch>
</VirtualHost>
