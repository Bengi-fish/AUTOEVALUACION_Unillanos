# Variables de entorno del sitio. Este archivo es solo un ejemplo: NO escriba
# aquí valores reales ni lo suba con ellos al repositorio. Defínalas en el
# servidor (grupo de PHP-FPM, servicio o archivo de entorno propio) y también en
# la consola desde la que corre drush.

# Sal de Drupal. Genérela con: openssl rand -hex 32
AUTOEVAL_HASH_SALT=

# Base de datos (MariaDB o MySQL).
AUTOEVAL_DB_NAME=autoeval
AUTOEVAL_DB_USER=autoeval
AUTOEVAL_DB_PASSWORD=
AUTOEVAL_DB_HOST=localhost
AUTOEVAL_DB_PORT=3306

# Dominio del sitio, sin https:// y sin barra final (por ejemplo,
# autoevaluacion.ejemplo.edu.co). Arma la lista de hosts de confianza.
AUTOEVAL_DOMINIO=

# Carpeta de archivos privados, FUERA de la raíz web.
AUTOEVAL_PRIVADO=/var/www/autoeval-privado

# Carpeta de respaldos (solo la usa deploy/respaldar.sh), FUERA del repositorio.
AUTOEVAL_RESPALDOS=/var/respaldos/autoeval
