# Ejemplo para nginx con PHP-FPM. Reemplace el dominio, las rutas y el
# certificado.
server {
  listen 80;
  server_name autoevaluacion.ejemplo.edu.co;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name autoevaluacion.ejemplo.edu.co;
  root /var/www/autoeval/drupal/web;
  index index.php;

  ssl_certificate /ruta/al/certificado.crt;
  ssl_certificate_key /ruta/a/la/clave.key;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;

  client_max_body_size 32m;

  location = /favicon.ico { log_not_found off; access_log off; }
  location = /robots.txt { allow all; log_not_found off; access_log off; }

  # Archivos que nunca se sirven.
  location ~ \.(engine|inc|install|make|module|profile|po|sh|sql|theme|twig|tpl(\.php)?|xtmpl|yml)(~|\.sw[op]|\.bak|\.orig|\.save)?$|^(\.(?!well-known).*|Entries.*|Repository|Root|Tag|Template|composer\.(json|lock)|web\.config)$|^#.*#$|\.php(~|\.sw[op]|\.bak|\.orig|\.save)$ {
    deny all;
    return 404;
  }

  # Los archivos subidos nunca se ejecutan como PHP.
  location ~ ^/sites/[^/]+/files/.*\.php$ { deny all; }

  location / {
    try_files $uri /index.php?$query_string;
  }

  location ~ '\.php$|^/update.php' {
    fastcgi_split_path_info ^(.+?\.php)(|/.*)$;
    try_files $fastcgi_script_name =404;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_param PATH_INFO $fastcgi_path_info;
    fastcgi_pass unix:/run/php/php8.4-fpm.sock;
  }

  location ~ ^/sites/.*/files/styles/ {
    try_files $uri @rewrite;
  }
  location @rewrite {
    rewrite ^ /index.php;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
    try_files $uri @rewrite;
    expires 30d;
    log_not_found off;
  }
}
